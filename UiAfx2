            end

            local l = Instance.new("TextLabel")
            l.Size = UDim2.new(1, icon and -40 or -20, 1, 0)
            l.Position = UDim2.new(0, icon and 34 or 12, 0, 0)
            l.BackgroundTransparency = 1
