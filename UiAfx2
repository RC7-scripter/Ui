            val.TextSize = 11
            val.TextXAlignment = Enum.TextXAlignment.Right
            val.Parent = f

            local list = Instance.new("Frame")
            list.Size = UDim2.new(1, 0, 0, 0)
            list.AutomaticSize = Enum.AutomaticSize.Y
            list.BackgroundColor3 = Theme.Sidebar
            list.BorderSizePixel = 0
            list.Visible = false
            list.Parent = page

            local ll = Instance.new("UIListLayout")
            ll.SortOrder = Enum.SortOrder.LayoutOrder
            ll.Padding = UDim.new(0, 3)
            ll.Parent = list
            local lp = Instance.new("UIPadding")
            lp.PaddingTop = UDim.new(0, 3)
            lp.PaddingBottom = UDim.new(0, 3)
            lp.PaddingLeft = UDim.new(0, 3)
            lp.PaddingRight = UDim.new(0, 3)
            lp.Parent = list

            local function build(items2)
                for _, c in pairs(list:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                for _, item in pairs(items2 or {}) do
                    local ib = Instance.new("TextButton")
                    ib.Size = UDim2.new(1, 0, 0, 26)
                    ib.BackgroundColor3 = Theme.Card
                    ib.Text = item
                    ib.TextColor3 = Theme.Text
                    ib.Font = Enum.Font.Gotham
                    ib.TextSize = 11
                    ib.BorderSizePixel = 0
                    ib.Parent = list
                    corner(ib, R_BTN)
                    ib.Activated:Connect(function()
                        selected = item
                        val.Text = item
                        val.TextColor3 = Theme.Accent
                        list.Visible = false
                        open = false
                        if cb then pcall(cb, item) end
                    end)
                end
            end

            f.Activated:Connect(function()
                open = not open
                list.Visible = open
            end)

            local dd = {
                SetItems = function(items2) build(items2) end,
                Get = function() return selected end
            }
            build(items)
            return dd
        end

        window.tabs[name] = tab
        return tab
    end

    return window
end

return AFX
