        ----------------------------------------------------
        -- TOGGLE: animated green switch
        ----------------------------------------------------
        function tab:AddToggle(txt, def, cb)
            local state = def or false

            local f = Instance.new("TextButton")
            f.Size = UDim2.new(1, 0, 0, 34)
            f.BackgroundColor3 = Theme.Card
            f.Text = ""
            f.BorderSizePixel = 0
            f.AutoButtonColor = false
            f.Parent = page
            corner(f, R_CARD)

            local l = Instance.new("TextLabel")
            l.Size = UDim2.new(1, -90, 1, 0)
            l.Position = UDim2.new(0, 12, 0, 0)
            l.BackgroundTransparency = 1
            l.Text = txt
            l.TextColor3 = Theme.Text
            l.Font = Enum.Font.GothamMedium
            l.TextSize = 12
            l.TextXAlignment = Enum.TextXAlignment.Left
            l.Parent = f

            local sw = Instance.new("Frame")
            sw.Size = UDim2.fromOffset(42, 22)
            sw.Position = UDim2.new(1, -54, 0.5, -11)
            sw.BackgroundColor3 = state and Theme.On or Theme.Off
            sw.BorderSizePixel = 0
            sw.Parent = f
            corner(sw, 11)

            local knob = Instance.new("Frame")
            knob.Size = UDim2.fromOffset(16, 16)
            knob.Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
            knob.BackgroundColor3 = Theme.Knob
            knob.BorderSizePixel = 0
            knob.Parent = sw
            corner(knob, 8)

            local function update(v)
                state = v
                tween(sw, TweenInfo.new(0.18), { BackgroundColor3 = state and Theme.On or Theme.Off })
                tween(knob, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    { Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8) })
            end

            f.Activated:Connect(function()
                update(not state)
                if cb then pcall(cb, state) end
            end)

            return {
                Set = function(v) update(v) if cb then pcall(cb, v) end end,
                Get = function() return state end
            }
        end

        ----------------------------------------------------
        -- SLIDER: icon kiri/kanan + knob
        ----------------------------------------------------
        function tab:AddSlider(txt, minV, maxV, def, cb, iconL, iconR)
            local value = def or minV

            local f = Instance.new("Frame")
            f.Size = UDim2.new(1, 0, 0, 44)
            f.BackgroundColor3 = Theme.Card
            f.BorderSizePixel = 0
            f.Parent = page
            corner(f, R_CARD)

            local l = Instance.new("TextLabel")
            l.Size = UDim2.new(1, -24, 0, 16)
            l.Position = UDim2.new(0, 12, 0, 4)
            l.BackgroundTransparency = 1
            l.Text = txt .. "  -  " .. tostring(value)
            l.TextColor3 = Theme.Text
            l.Font = Enum.Font.GothamMedium
            l.TextSize = 12
            l.TextXAlignment = Enum.TextXAlignment.Left
            l.Parent = f

            local bar = Instance.new("Frame")
            bar.Size = UDim2.new(1, -40, 0, 6)
            bar.Position = UDim2.new(0, 26, 1, -15)
            bar.BackgroundColor3 = Theme.Off
            bar.BorderSizePixel = 0
            bar.Parent = f
            corner(bar, 3)

            local fill = Instance.new("Frame")
            local pct = (value - minV) / (maxV - minV)
            fill.Size = UDim2.new(pct, 0, 1, 0)
            fill.BackgroundColor3 = Theme.Accent
            fill.BorderSizePixel = 0
            fill.Parent = bar
            corner(fill, 3)

            local knob = Instance.new("Frame")
            knob.Size = UDim2.fromOffset(16, 16)
            knob.Position = UDim2.new(pct, -8, 0.5, -8)
            knob.BackgroundColor3 = Theme.Knob
            knob.BorderSizePixel = 0
            knob.Parent = bar
            corner(knob, 8)

            if iconL then
                local il = Instance.new("TextLabel")
                il.Size = UDim2.fromOffset(16, 16)
                il.Position = UDim2.new(0, 6, 0.5, -8)
                il.BackgroundTransparency = 1
                il.Text = iconL
                il.TextColor3 = Theme.Sub
                il.Font = Enum.Font.Gotham
                il.TextSize = 11
                il.Parent = bar
            end
            if iconR then
                local ir = Instance.new("TextLabel")
                ir.Size = UDim2.fromOffset(16, 16)
                ir.Position = UDim2.new(1, -22, 0.5, -8)
                ir.BackgroundTransparency = 1
                ir.Text = iconR
                ir.TextColor3 = Theme.Sub
                ir.Font = Enum.Font.Gotham
                ir.TextSize = 11
                ir.Parent = bar
            end

            local dragging = false
            bar.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1
                or inp.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1
                or inp.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement
                or inp.UserInputType == Enum.UserInputType.Touch) then
                    local rel = math.clamp((inp.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                    value = math.floor(minV + (maxV - minV) * rel + 0.5)
                    fill.Size = UDim2.new(rel, 0, 1, 0)
                    knob.Position = UDim2.new(rel, -8, 0.5, -8)
                    l.Text = txt .. "  -  " .. tostring(value)
                    if cb then pcall(cb, value) end
                end
            end)

            return {
                Set = function(v)
                    value = math.clamp(v, minV, maxV)
                    local r = (value - minV) / (maxV - minV)
                    fill.Size = UDim2.new(r, 0, 1, 0)
                    knob.Position = UDim2.new(r, -8, 0.5, -8)
                    l.Text = txt .. "  -  " .. tostring(value)
                    if cb then pcall(cb, value) end
                end,
                Get = function() return value end
            }
        end

